# Copy this file to .env.local and fill in the values.

# --- Order alerts by email (required) ---------------------------------------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (16 letters, no spaces).
SMTP_USER=your_email_here
SMTP_PASS=your_smtp_password_here
SMTP_PORT=add number
# Where order alerts are delivered. Leave out to use SMTP_USER.
ORDER_NOTIFY_EMAIL=your_email_here

# --- Instant phone alert via Telegram (optional) ----------------------------
# Create a bot with @BotFather to get the token, message your bot once,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Site address, no trailing slash ----------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

